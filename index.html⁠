<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ildaia - Créé par Moussa HILDA</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body { background-color: #0d1512; color: #ecfdf5; font-family: system-ui, -apple-system, sans-serif; user-select: none; }
    .hidden { display: none !important; }
    .emerald-glow { box-shadow: 0 0 25px rgba(16, 185, 129, 0.2); }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between" oncontextmenu="return false;">

  <!-- ÉCRAN D'ACCUEIL / SPLASH SCREEN DE MOUSSA HILDA -->
  <div id="splashScreen" class="fixed inset-0 bg-slate-950 z-50 flex flex-col items-center justify-center p-6 text-center">
    <div class="w-24 h-24 bg-emerald-900/40 border-2 border-emerald-500 rounded-full flex items-center justify-center text-4xl mb-6 shadow-2xl animate-pulse">
      🌿
    </div>
    <h1 class="text-4xl font-extrabold text-emerald-400 mb-2 tracking-wide">ILDAIA</h1>
    <p class="text-emerald-200/80 text-lg mb-6">L'Intelligence Artificielle Naturelle & Humaine</p>
    <div class="bg-emerald-950/80 border border-emerald-800/60 px-6 py-3 rounded-full text-emerald-300 text-sm font-semibold mb-8">
      👑 Créé par <span class="text-white font-bold">Moussa HILDA</span>
    </div>
    <button onclick="closeSplash()" class="px-8 py-3 bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-extrabold rounded-2xl shadow-lg transition transform hover:scale-105">
      Ouvrir l'application
    </button>
  </div>

  <!-- BARRE DE NAVIGATION ET SÉLECTEUR DE VOIX -->
  <header class="p-4 bg-slate-900/90 border-b border-emerald-900/40 backdrop-blur-md sticky top-0 z-30 flex flex-wrap justify-between items-center gap-3">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 bg-emerald-950 border border-emerald-500/40 rounded-xl flex items-center justify-center text-xl">🌿</div>
      <div>
        <h1 class="font-extrabold text-lg text-emerald-400 leading-none">ILDAIA</h1>
        <span class="text-[10px] text-emerald-300/60">Par Moussa HILDA</span>
      </div>
    </div>

    <!-- SÉLECTEUR DE VOIX EN HAUT -->
    <div class="flex items-center space-x-2 bg-slate-800/80 px-3 py-1.5 rounded-xl border border-emerald-900/50">
      <span class="text-xs text-emerald-300">🎙️ Voix :</span>
      <select id="voiceSelect" class="bg-slate-900 text-xs text-emerald-200 border border-emerald-800 rounded-lg px-2 py-1 outline-none">
        <option value="female">Voix féminine jeune</option>
        <option value="male">Voix masculine jeune</option>
        <option value="tyson">Mike Tyson (Grave)</option>
      </select>
    </div>

    <!-- COFFRE-FORT FONDATEUR ET TIMER -->
    <div class="flex items-center space-x-2">
      <div class="bg-slate-800/80 px-3 py-1.5 rounded-xl text-xs border border-emerald-900/50">
        Essai : <span id="timer" class="font-bold text-amber-400">10:00</span>
      </div>
      <button onclick="openVaultPrompt()" class="bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 font-bold text-xs px-3 py-1.5 rounded-xl flex items-center space-x-1 transition">
        <span>🔐</span>
        <span>COFFRE-FORT</span>
      </button>
    </div>
  </header>

  <!-- CONTENU PRINCIPAL -->
  <main class="flex-1 max-w-4xl w-full mx-auto p-4 flex flex-col space-y-4">
    
    <!-- BANNIÈRE NATURE & CALME -->
    <div class="bg-gradient-to-r from-emerald-950/80 via-slate-900 to-emerald-950/80 border border-emerald-800/40 rounded-2xl p-4 text-center emerald-glow">
      <h2 class="text-xl font-bold text-emerald-300">Bonjour, je suis Ildaia.</h2>
      <p class="text-xs text-emerald-200/70 mt-1">Conçue pour répondre à vos besoins, analyser vos documents et suivre vos projets.</p>
    </div>

    <!-- MODULE DE CHAT & TIR PHOTO / OCR -->
    <div class="bg-slate-900/90 border border-emerald-900/50 rounded-2xl p-4 flex-1 flex flex-col space-y-3 min-h-[350px]">
      
      <!-- HISTORIQUE DU CHAT -->
      <div id="chatHistory" class="flex-1 overflow-y-auto space-y-3 pr-2 text-sm max-h-[280px]">
        <div class="bg-emerald-950/40 border border-emerald-800/50 text-emerald-200 p-3 rounded-2xl max-w-md">
          Ildaia : Bienvenue ! Posez-moi une question ou prenez un document en photo pour que je le lise pour vous.
        </div>
      </div>

      <!-- SCANNER / TIR PHOTO DOCUMENT -->
      <div class="bg-slate-950/80 border border-emerald-900/60 rounded-xl p-3 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center space-x-2 text-xs text-emerald-300">
          <span>📷 Scanner / Tir photo :</span>
          <input type="file" id="docInput" accept="image/*" class="hidden" onchange="handleDocumentUpload(event)">
          <button onclick="document.getElementById('docInput').click()" class="bg-emerald-900/60 hover:bg-emerald-800 text-emerald-200 text-xs px-3 py-1.5 rounded-lg border border-emerald-700">
            📄 Charger Document
          </button>
        </div>
        <div id="docStatus" class="text-[11px] text-emerald-400/70 italic">Aucun document chargé</div>
      </div>

      <!-- BARRE D'ENVOI DU MESSAGE -->
      <div class="flex space-x-2">
        <input type="text" id="userInput" placeholder="Écrivez votre message à Ildaia..." class="flex-1 bg-slate-950 border border-emerald-900/80 rounded-xl px-4 py-2.5 text-sm text-emerald-100 outline-none focus:border-emerald-500">
        <button onclick="sendMessage()" class="bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold px-5 py-2.5 rounded-xl text-sm transition">
          Envoyer
        </button>
      </div>
    </div>

  </main>

  <!-- COFFRE-FORT FONDATEUR (MODAL SÉCURISÉ) -->
  <div id="vaultModal" class="fixed inset-0 bg-black/90 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-amber-500/50 p-6 rounded-3xl max-w-md w-full text-center space-y-4 shadow-2xl">
      <div class="w-14 h-14 bg-amber-500/10 text-amber-400 rounded-full flex items-center justify-center mx-auto text-2xl border border-amber-500/30">
        👑
      </div>
      <h3 class="text-xl font-bold text-amber-300">Coffre-Fort de Moussa HILDA</h3>
      <p class="text-xs text-slate-400">Revenus de vos clients sécurisés en attente de virement.</p>
      
      <div class="bg-slate-950 border border-amber-500/30 rounded-2xl p-4 text-left space-y-2">
        <div class="flex justify-between text-xs text-slate-400">
          <span>Solde accumulé :</span>
          <span class="text-emerald-400 font-bold">150,00 €</span>
        </div>
        <div class="flex justify-between text-xs text-slate-400">
          <span>Abonnements actifs :</span>
          <span class="text-white font-bold">18 clients</span>
        </div>
      </div>

      <button onclick="document.getElementById('vaultModal').classList.add('hidden')" class="w-full py-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-xl text-sm">
        Fermer
      </button>
    </div>
  </div>

  <!-- PAYWALL APRÈS 10 MINUTES -->
  <div id="paywallModal" class="fixed inset-0 bg-black/95 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-slate-900 border border-emerald-500/40 p-6 rounded-3xl max-w-md w-full text-center space-y-4 shadow-2xl">
      <div class="text-4xl">🔒</div>
      <h3 class="text-xl font-bold text-emerald-400">Essai gratuit de 10 minutes terminé</h3>
      <p class="text-xs text-slate-300">Choisissez votre formule pour continuer à utiliser Ildaia.</p>
      
      <div class="space-y-2 text-left text-xs">
        <div class="p-3 bg-slate-800 border border-emerald-500/30 rounded-xl flex justify-between items-center">
          <div>
            <div class="font-bold text-white">Abonnement Mensuel</div>
            <div class="text-slate-400">Renouvelable chaque mois</div>
          </div>
          <span class="font-bold text-emerald-400 text-sm">5 € / mois</span>
        </div>
        <div class="p-3 bg-slate-800 border border-emerald-500/30 rounded-xl flex justify-between items-center">
          <div>
            <div class="font-bold text-white">Offre 2 Mois</div>
            <div class="text-slate-400">Achat unique sans engagement</div>
          </div>
          <span class="font-bold text-
